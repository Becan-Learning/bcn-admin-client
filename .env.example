# Backend (bcn-backend-main) that /api/auth/* and /api/v1/* are proxied to.
# Required in production: the app refuses to start without it. Defaults to http://localhost:3000 in dev.
# The backend must list this app's origin in its ADMIN_ORIGIN (http://localhost:3002 in dev).
BACKEND_URL=http://localhost:3000

# Server-only, optional. The Langfuse project the Sessions table links to, for example
# https://cloud.langfuse.com/project/<id>. Each Session links to ${LANGFUSE_PROJECT_URL}/sessions/<room>.
# Unset: the Sessions table shows no Langfuse links.
LANGFUSE_PROJECT_URL=
